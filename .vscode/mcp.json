{
  "servers": {
    "shadcnVue": {
      "command": "npx",
      "args": [
        "shadcn-vue@latest",
        "mcp"
      ]
    },
    "gitnexus": {
      "command": "npx",
      "args": ["-y", "gitnexus@latest", "mcp"]
    },
    "socratiCode": {
      "command": "npx",
      "args": [
        "@socraticode/mcp@latest",
        "--stdio"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "ctx7@latest",
        "--mcp"
      ]
    }
  }
}
