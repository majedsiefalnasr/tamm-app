{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "shadcnVue": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "shadcn-vue@latest",
        "mcp"
      ]
    },
    "gitnexus": {
      "type": "local",
      "enabled": true,
      "command": ["gitnexus", "mcp"]
    },
    "socratiCode": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "@socraticode/mcp@latest",
        "--stdio"
      ]
    }
  }
}
